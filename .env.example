# LLM Settings (Gemini or OpenAI)
# Recommended: Set GEMINI_API_KEY for free-tier LLM generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_EFFORT=medium

# OpenAI Settings (optional / image generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard

# Target Cooker: mc (Monsieur Cuisine) or tm (Thermomix)
TARGET_DEVICE=mc

# Monsieur Cuisine Settings
MC_LOCALE=de-DE
MC_COOKIE=
MC_LOGIN=
MC_PW=
MC_HAS_FOOD_PROCESSOR=false

# Thermomix Settings
TM_VERSION=tm6
TM_LOCALE=de-DE
TM_COOKIE=
TM_COOKIES=
TM_LOGIN=
TM_PW=

# CLI / browser login behavior
SAVE_SETTINGS=true
SMART_RECIPE_BROWSER_CHANNEL=
SMART_RECIPE_BROWSER_PATH=
SMART_RECIPE_BROWSER_SANDBOX=
